{
  "name": "lzcontr",
  "version": "1.0.1",
  "description": "LZContr 合同生成器 - 研发/销售合同与报价单条款填写与 Word 生成",
  "author": {
    "name": "LZContr",
    "email": "dev@lzcontr.local"
  },
  "homepage": "https://github.com/lzcontr/lzcontr",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "server": "node server/index.js",
    "dev": "vite",
    "dev:full": "concurrently -k -n server,web -c blue,green \"npm run server\" \"npm run dev\"",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "preview": "vite preview",
    "desktop:dev": "npm run build && electron .",
    "desktop": "electron .",
    "dist:desktop": "electron-builder",
    "dist:win": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage deb"
  },
  "dependencies": {
    "@remixicon/vue": "^4.6.0",
    "docx": "^9.15.2",
    "express": "^5.3.0",
    "file-saver": "^2.0.5",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^10.0.6",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "puppeteer-core": "^25.16.0",
    "vite": "^6.0.7"
  }
}
